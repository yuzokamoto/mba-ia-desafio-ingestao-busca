# Provedor usado para embeddings e LLM: openai ou gemini.
# Se ficar vazio, usa o provedor cuja chave estiver preenchida (OpenAI tem prioridade).
LLM_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL='text-embedding-3-small'
OPENAI_LLM_MODEL='gpt-6-luna'

# Gemini (Google AI Studio)
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL='gemini-embedding-001'
GOOGLE_LLM_MODEL='gemini-3.5-flash-lite'

# Banco (valores do docker-compose.yml)
DATABASE_URL='postgresql+psycopg://postgres:postgres@localhost:5432/rag'
PG_VECTOR_COLLECTION_NAME='document_chunks'

# Caminho do PDF (relativo à raiz do projeto)
PDF_PATH='document.pdf'
